FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HAOLEME_CLOUD_HOST=0.0.0.0 \
    HAOLEME_CLOUD_PORT=8000 \
    HAOLEME_CLOUD_DB=/data/haoleme-cloud.db \
    HAOLEME_CLOUD_LOG=/data/cloud.log \
    PYTHONPATH=/app/src

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

VOLUME ["/data"]
EXPOSE 8000 8001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -m haoleme.cloud_server health --db "$HAOLEME_CLOUD_DB" >/dev/null || exit 1

CMD ["python", "-m", "haoleme.cloud_server", "serve"]
