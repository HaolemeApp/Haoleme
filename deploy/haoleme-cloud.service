[Unit]
Description=Haoleme Cloud API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haoleme
Group=haoleme
Environment=HAOLEME_CLOUD_HOST=127.0.0.1
Environment=HAOLEME_CLOUD_PORT=8000
Environment=HAOLEME_CLOUD_DB=/opt/haoleme-cloud-data/haoleme-cloud.db
Environment=HAOLEME_CLOUD_LOG=/opt/haoleme-cloud-data/logs/cloud.log
Environment=MIN_ANDROID_VERSION_CODE=66
Environment=HAOLEME_REQUIRE_E2EE=1
Environment=HAOLEME_ALLOW_LEGACY_ADMIN_TOKENS=0
Environment=HAOLEME_ALLOW_EXISTING_LEGACY_ACCOUNTS=1
ExecStart=/usr/local/bin/haoleme-cloud serve
Restart=always
RestartSec=3
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/haoleme-cloud-data

[Install]
WantedBy=multi-user.target
